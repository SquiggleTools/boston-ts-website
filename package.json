{
	"name": "boston-ts-website",
	"version": "0.0.0",
	"private": true,
	"description": "The website for Boston TypeScript. Powered by React, Remix, TypeScript, and Vanilla Extract. ✨",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SquiggleTools/boston-ts-website.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"type": "module",
	"scripts": {
		"build": "remix vite:build",
		"dev": "remix vite:dev",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"tsc": "tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"@remix-run/css-bundle": "^2.11.1",
		"@remix-run/dev": "^2.11.1",
		"@remix-run/node": "^2.11.1",
		"@remix-run/react": "^2.11.1",
		"@remix-run/server-runtime": "^2.11.1",
		"@vanilla-extract/css": "^1.15.3",
		"@vercel/remix": "^2.11.1",
		"clsx": "^2.1.1",
		"isbot": "^5.1.13",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "8.0.3",
		"@types/node": "26.6.2",
		"@types/react": "^18.3.3",
		"@vanilla-extract/vite-plugin": "^4.0.13",
		"cspell": "10.4.0",
		"eslint": "10.14.0",
		"eslint-plugin-jsdoc": "65.4.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.9.0",
		"husky": "9.1.7",
		"knip": "6.44.0",
		"lint-staged": "17.6.0",
		"prettier": "^3.9.6",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0",
		"vite": "^5.3.5",
		"vite-tsconfig-paths": "^4.3.1"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
